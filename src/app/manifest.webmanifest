{
  "id": "signal4kaios",
  "name": "Beacon",
  "short_name": "Beacon",
  "description": "Unofficial client for Signal accounts. Not affiliated with Signal.",
  "lang": "en-US",
  "start_url": "/index.html",
  "display": "standalone",
  "theme_color": "#2c6bed",
  "background_color": "#fafafa",
  "orientation": "portrait-primary",
  "icons": [
    { "src": "/assets/icons/kaios_56.png", "type": "image/png", "sizes": "56x56" },
    { "src": "/assets/icons/kaios_112.png", "type": "image/png", "sizes": "112x112" }
  ],
  "b2g_features": {
    "version": "2.9.4",
    "type": "privileged",
    "origin": "signal4kaios",
    "subtitle": "For Signal accounts",
    "focus_color": "#2c6bed",
    "developer": {
      "name": "Amber Caravalho",
      "url": "https://github.com/ambercaravalho/signal4kaios"
    },
    "cursor": false,
    "permissions": {
      "systemXHR": {
        "description": "Load link previews and files stored outside Signal's servers"
      },
      "tcp-socket": {
        "description": "Connect securely to Signal servers using Signal's own certificate"
      },
      "desktop-notification": {
        "description": "Show notifications for new Signal messages"
      },
      "alarms": {
        "description": "Periodically wake to reconnect and catch up on messages"
      },
      "video-capture": {
        "description": "Use the camera to scan QR codes"
      },
      "audio-capture": {
        "description": "Record voice messages"
      },
      "device-storage:pictures": {
        "access": "readcreate",
        "description": "Save received photos to the gallery"
      },
      "device-storage:music": {
        "access": "readcreate",
        "description": "Save received voice messages and audio"
      },
      "device-storage:videos": {
        "access": "readcreate",
        "description": "Save received videos"
      },
      "device-storage:sdcard": {
        "access": "readcreate",
        "description": "Save received files"
      }
    },
    "serviceworker": {
      "script_url": "/sw.js",
      "update_via_cache": "none"
    },
    "messages": [
      "alarm"
    ]
  }
}
