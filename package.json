{
  "name": "signal4kaios",
  "version": "2.0.0",
  "private": true,
  "description": "Standalone on-device Signal client for KaiOS 3.0, 3.1, and 4.0",
  "scripts": {
    "build": "esbuild src/engine/index.ts --bundle --format=iife --target=es2020 --outfile=app/vendor/signal-engine.bundle.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/**/*.test.js",
    "package": "npm run build && sh app/scripts/package.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1",
    "@noble/post-quantum": "^0.7.1",
    "protobufjs": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2"
  }
}
