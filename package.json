{
  "name": "signal4kaios",
  "version": "2.10.1",
  "private": true,
  "description": "Beacon: an unofficial, standalone Signal client for KaiOS 3.0, 3.1, and 4.0",
  "scripts": {
    "build:wasm": "sh src/native/libsignal-wasm/build.sh",
    "gen:protos": "PATH=\"$PWD/node_modules/.bin:$PATH\" buf generate",
    "build": "node scripts/build.mjs",
    "icons": "node scripts/icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/*.test.ts test/*.test.tsx --bundle --platform=node --format=cjs --target=node22 --jsx=automatic --jsx-import-source=preact --loader:.css=empty --log-override:empty-import-meta=silent --alias:wasi_snapshot_preview1=./src/engine/protocol/wasi.ts --external:@signalapp/libsignal-client --external:'@signalapp/libsignal-client/*' --outdir=dist-test && node --test 'dist-test/*.test.js'",
    "test:live": "esbuild test/live/*.live.ts --bundle --platform=node --format=cjs --target=node22 --log-override:empty-import-meta=silent --alias:wasi_snapshot_preview1=./src/engine/protocol/wasi.ts --outdir=dist-test/live && node --test 'dist-test/live/*.live.js'",
    "package": "sh scripts/package.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@signalapp/types": {
      "uuid": "^13.0.1",
      "zod": "^4.6.6"
    }
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@bufbuild/protobuf": "2.17.0",
    "@noble/hashes": "^2.4.0",
    "blurhash": "^2.0.5",
    "preact": "^11.2.0",
    "qr": "^0.7.2",
    "unicode-emoji-json": "^0.9.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@resvg/resvg-js": "^2.6.2",
    "@signalapp/libsignal-client": "0.106.2",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8",
    "preact-render-to-string": "^6.8.2",
    "typescript": "^7.0.2"
  }
}
