{
  "name": "signal4kaios-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Gateway in front of signal-cli-rest-api for signal4kaios: HTTP reverse proxy, receive-WebSocket relay with buffered backlog, and Web Push for closed-app notifications.",
  "license": "GPL-3.0-or-later",
  "type": "commonjs",
  "engines": {
    "node": ">=26"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "pair": "node dist/cli.js pair",
    "devices": "node dist/cli.js devices",
    "revoke": "node dist/cli.js revoke",
    "test": "tsc -p tsconfig.test.json && node --test 'dist-test/**/*.test.js'",
    "dev": "npm run build && node --watch dist/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "web-push": "^3.6.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
